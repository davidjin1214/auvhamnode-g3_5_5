# High-resolution raster figure exports (journal-submission assets, e.g. ~16 MB TIFFs).
# The manuscript compiles from the vector .pdf; tracked figures keep .pdf/.svg/.png.
# Regenerate TIFFs from the tracked make_*.py scripts when a publisher requires them.
paper/**/*.tiff
paper/**/*.tif

# Claude Code local (personal) settings — machine-specific permission allowlist
# with local absolute paths. Shared repo tooling under .claude/ (agents/, skills/)
# stays tracked; only this per-machine file is ignored.
.claude/settings.local.json

